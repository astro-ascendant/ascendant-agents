{
  "name": "ascendant-agents",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "ascendant": "node --experimental-strip-types skills/ascendant/tools/ascendant.ts",
    "init-person": "node --experimental-strip-types skills/ascendant/tools/ascendant.ts init-person",
    "check-transit": "node --experimental-strip-types skills/ascendant/tools/ascendant.ts transit",
    "test": "bun test",
    "build:skill": "node scripts/build-skill.mjs",
    "check:plugin": "node scripts/check-plugin-externals.mjs",
    "sync-versions": "node scripts/sync-versions.mjs",
    "changeset": "changeset",
    "version": "node scripts/sync-versions.mjs",
    "typecheck": "tsc --project skills/ascendant/tsconfig.json --noEmit && tsc --project .opencode/tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt skills/ascendant/tools scripts .opencode/plugins *.json .oxlintrc.json .oxfmtrc.json skills/ascendant/tsconfig.json .opencode/tsconfig.json",
    "format:check": "npm run format -- --check"
  },
  "dependencies": {
    "@effect/platform-node-shared": "^4.0.4",
    "@toon-format/toon": "4.4.0",
    "astro-ascendant": "5.1.0",
    "effect": "^4.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "bun-types": "1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@toon-format/toon": "4.4.0"
  },
  "trustedDependencies": [
    "@swisseph/node",
    "msgpackr-extract"
  ]
}
